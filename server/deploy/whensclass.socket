# /etc/systemd/system/whensclass.socket — ставит владелец. С 29.09.2026.
# Сокет службы держит systemd, а не uvicorn: на перезапуске и выкладке запросы
# ждут в очереди, а не падают. Раньше сокет создавал uvicorn и оставлял на
# месте только потому, что на сервере Python 3.12: с 3.13 asyncio стирает его
# при остановке, и nginx снова писал бы в журнал ошибок уровня crit адрес
# телефона со строкой запроса.
[Unit]
Description=WhensClass API socket

[Socket]
ListenStream=/run/whensclass/api.sock
# Подключиться может только группа whensclass — в ней пользователь nginx.
# Каталог при этом открыт (0755): закрыт сам сокет, а не путь к нему.
SocketUser=whensclass
SocketGroup=whensclass
SocketMode=0660
DirectoryMode=0755

[Install]
WantedBy=sockets.target
