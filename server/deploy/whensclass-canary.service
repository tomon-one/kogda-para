# /etc/systemd/system/whensclass-canary.service — ставит владелец.
# Канарейка раз в сутки: не переделали ли таблицу (tools/check_source.py).
# Раньше — строка crontab root без env: без темы ntfy и ключа Sheets API
# (дефект 9), и от root, без ужесточения службы, по каталогу, куда пишет
# служба. Теперь от whensclass, с тем же env и теми же
# ограничениями, что у службы; вывод — в journald.
[Unit]
Description=WhensClass canary: does the college sheet still parse
After=network-online.target

[Service]
Type=oneshot
User=whensclass
Group=whensclass
WorkingDirectory=/opt/whensclass
EnvironmentFile=/etc/whensclass/env
ExecStart=/opt/whensclass/.venv/bin/python tools/check_source.py --quiet --state-dir /var/lib/whensclass
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ReadWritePaths=/var/lib/whensclass
ReadOnlyPaths=-/var/lib/whensclass/apk

# Узкий профиль процесса: канарейка разбирает
# сетевой ввод, и если её всё же захватят, пусть это будет процесс без
# лишних семейств адресов, системных вызовов и чужих процессов в /proc.
# Только то, что не мешает Python, uvicorn и httpx; PrivateUsers и
# ProcSubset не ставим — первое путает группу сокета для nginx, второе
# прячет /proc/meminfo, который читают библиотеки.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

