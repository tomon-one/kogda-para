*.aab

# Ключ подписи и пароли лежат вне репозитория, в ~/WhensClass-keys.
# Здесь — на случай, если их когда-нибудь положат внутрь: потеря ключа
# означает, что обновить приложение у одногруппников уже нельзя.
*.keystore
*.jks
keystore.properties

# Локальные секреты и состояние
.env
server/var/

# Мусор ОС и редакторов
.DS_Store
Thumbs.db
*.swp

# Рабочие файлы: правила для Клода, состояние системы, текущий заход.
# Живут на диске рядом с кодом, но в репозиторий не идут — это леса,
# а не здание. Репозиторий показывает приложение, а не то, как его делают.
CLAUDE.md
handoff.md
current.md
