<!--
  Циферблат со стрелками на девяти часах — время первой пары — и три строки
  расписания под ним. Векторная, чтобы не тащить растр в шести размерах.
  Рисунок держится в центральных 72dp из 108: края адаптивной иконки на
  разных оболочках обрезаются по-разному.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Обод циферблата -->
    <path
        android:fillColor="#5FD3A8"
        android:pathData="M54,24 C69.46,24 82,36.54 82,52 C82,67.46 69.46,80 54,80 C38.54,80 26,67.46 26,52 C26,36.54 38.54,24 54,24 Z M54,31 C42.4,31 33,40.4 33,52 C33,63.6 42.4,73 54,73 C65.6,73 75,63.6 75,52 C75,40.4 65.6,31 54,31 Z" />

    <!-- Стрелки: без четверти двенадцать пополуночи никто не учится,
         поэтому показываем девять утра. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M51.5,38 L56.5,38 L56.5,53 L51.5,53 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,49.5 L56,49.5 L56,54.5 L38,54.5 Z" />

    <!-- Строки расписания -->
    <path
        android:fillColor="#5FD3A8"
        android:pathData="M34,86 L74,86 L74,90 L34,90 Z" />
    <path
        android:fillColor="#3E8F76"
        android:pathData="M34,94 L62,94 L62,98 L34,98 Z" />
</vector>
