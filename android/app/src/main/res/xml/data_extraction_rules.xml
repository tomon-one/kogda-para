<?xml version="1.0" encoding="utf-8"?>
<!--
  Ничего не уходит ни в облако, ни на новый телефон при переносе. С targetSdk 31
  одного allowBackup="false" мало: он выключает облако Google, а перенос между
  устройствами у части производителей оставался включённым, хотя README и
  install.md обещают, что всё остаётся на этом телефоне (второй аудит, М40).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
