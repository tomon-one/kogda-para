<?xml version="1.0" encoding="utf-8"?>
<!--
  Нижняя граница: 250×200, при растягивании — 250×190. По ширине это время
  пары, название и обе стрелки; по высоте — шапка и две строки пар целиком.
  Уже или ниже виджет начинает резать текст, поэтому оболочке это запрещено —
  хотя Nova запрет и не соблюдает, о чём знает сам виджет.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="200dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="190dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0" />
