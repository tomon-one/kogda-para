<?xml version="1.0" encoding="utf-8"?>
<!-- Отсюда установщику отдаётся скачанное обновление.

     Внутренняя память приложения, а не общая внешняя: в /sdcard/Android/data
     на Android 8-10 может писать любое приложение с правом на память, и
     обещание «подсунуть поддельное обновление нельзя» там не работало. -->
<paths>
    <files-path name="updates" path="updates/" />
</paths>
