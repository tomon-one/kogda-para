<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Обновление приложения: файл скачивается с нашего сервера, а установку
         всё равно подтверждает человек — молча поставить APK нельзя. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Напоминания о парах и сообщения об изменениях. Оба вида можно
         выключить в настройках приложения. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Точное время напоминания. Без него система вправе отложить будильник
         на десятки минут, и предупреждение приходит, когда пара уже идёт.
         Разрешение выдаётся человеком в настройках телефона; не выдали —
         приложение ставит неточный будильник и продолжает работать. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Системное окно «Разрешить работу в фоне?». Спрашивается только по
         кнопке в разделе «Работа в фоне» — на Xiaomi, Huawei, Honor и Samsung,
         где без этого не приходят обновление и будильники звонка. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Без него Huawei на EMUI 10–11 не открывает чужому приложению свой
         экран «Запуск приложений» (тот же раздел). На остальных телефонах
         такого разрешения нет, и оно ничего не значит. -->
    <uses-permission android:name="com.huawei.permission.external_app_settings.USE_COMPONENT" />

    <!-- Найти системный установщик: обновление уходит ему явно, а не любому
         приложению с фильтром на APK. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <!-- Резервное копирование выключено намеренно. При allowBackup="true"
         Android забирает в облако Google весь каталог files/, а там лежит
         DataStore: выбранные группы, фамилия преподавателя и снимок
         расписания. В README обещано, что всё хранимое остаётся на телефоне и
         исчезает вместе с ним, — вот и остаётся. -->
    <application
        android:name=".WhensClassApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WhensClass">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Отдаёт скачанный файл системному установщику: напрямую путь к
             файлу другому приложению передавать нельзя. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Копирование ссылки из виджета. С Android 10 писать в буфер обмена
             может только приложение на переднем плане, поэтому нажатие
             открывает это окно: оно копирует и мгновенно закрывается. -->
        <activity
            android:name=".widget.CopyLinkActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WhensClass.Invisible" />

        <receiver
            android:name=".widget.ScheduleWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_day_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info" />
        </receiver>

        <!-- Тот же виджет, но на одну пару: менять размер умеет не всякая
             оболочка, а места на домашнем экране обычно нет. -->
        <receiver
            android:name=".widget.NextLessonWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_next_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_lesson_widget_info" />
        </receiver>

        <!-- Неделя целиком: большой виджет отвечает на «что сегодня»,
             этот — на «когда окно» и «что в четверг». -->
        <receiver
            android:name=".widget.WeekWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_week_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>

        <receiver
            android:name=".notify.LessonAlarmReceiver"
            android:exported="false" />

        <!-- Смена суток, перезагрузка, перевод часов и обновление приложения:
             после каждого из этих событий виджет обязан перерисоваться. -->
        <receiver
            android:name=".work.MidnightReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
